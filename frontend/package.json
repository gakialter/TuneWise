{
  "name": "tunewise-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build && npm run build:process-aware-demo",
    "build:process-aware-demo": "tsc -p tsconfig.process-aware.json && vite build --config vite.process-aware.config.ts",
    "test": "vitest run",
    "qa:browser": "node e2e/browser-qa.mjs",
    "qa:process-aware": "node e2e/process-aware-qa.mjs"
  },
  "dependencies": {
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "playwright": "1.61.1",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
